/* 256x256-bit multiply: w1:w0 = w0 * w1. */

require "mul256.jinc"

export
fn mul256(reg u256 x y) -> reg u256, reg u256 {
  reg u256 lo hi;
  reg bool mf lf zf;

  lo, hi, mf, lf, zf = mul256_full(x, y);

  return lo, hi;
}
